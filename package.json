{
  "name": "my-test-react-app",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "prepare": "husky",
    "cy:open:component": "cypress open --component",
    "cy:open:e2e": "cypress open --e2e",
    "test:component": "cypress run --component --browser chrome",
    "test:e2e": "start-server-and-test dev http://localhost:5173 \"cypress run --e2e\"",
    "test": "npm run coverage:clean && npm run test:component && npm run test:e2e",
    "coverage:clean": "rm -rf .nyc_output coverage",
    "coverage:report": "nyc report --reporter=text --reporter=html",
    "coverage:check": "nyc check-coverage"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "classnames": "^2.5.1",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^4.0.3",
    "@cypress/react": "^10.0.0",
    "@cypress/vite-dev-server": "^8.0.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "cypress": "^15.21.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-unicorn": "^65.0.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nyc": "^18.0.0",
    "prettier": "^3.9.9",
    "start-server-and-test": "^2.1.5",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.3.0",
    "vite-plugin-istanbul": "^9.0.1"
  }
}
